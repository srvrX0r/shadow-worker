   docker:
     name: docker
     runs-on: ubuntu-latest
+    timeout-minutes: 25
     steps:
       - uses: actions/checkout@v4
       - uses: docker/setup-buildx-action@v4
-      - uses: docker/build-push-action@v6
+
+      - name: Build image
+        uses: docker/build-push-action@v7
         with:
           context: .
-          push: false
+          load: true # load into the local store so the smoke test can run it
           tags: shadow-worker:ci
           cache-from: type=gha
           cache-to: type=gha,mode=max
+
+      - name: Smoke test image
+        run: |
+          set -euo pipefail
+          docker run --rm shadow-worker:ci --version
+          docker run --rm shadow-worker:ci --help > /dev/null
+          docker run --rm shadow-worker:ci status > /dev/null
+
+          # The runtime must stay non-root (see Dockerfile USER directive).
+          uid=$(docker run --rm --entrypoint python shadow-worker:ci -c 'import os; print(os.getuid())')
+          test "$uid" = "10001"
+
+          # Detection rules must be baked into the image, and the data dir must
